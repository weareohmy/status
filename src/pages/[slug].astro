---
import sites from "../../config/sites.json";

export async function getStaticPaths() {
  return sites.map((s) => ({ params: { slug: s.slug } }));
}

const site = sites.find((s) => s.slug === Astro.params.slug);
if (!site) throw new Error("Unknown site slug");

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — Status</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --green: #4aeaab;
        --green-dim: rgba(74, 234, 171, 0.12);
        --amber: #f4c97a;
        --amber-dim: rgba(244, 201, 122, 0.12);
        --red: #f87171;
        --red-dim: rgba(248, 113, 113, 0.12);
        --bg: #080a10;
        --surface: #0f1117;
        --border: #1e2130;
        --border-hover: #2a2d3a;
        --text: #e8eaf0;
        --text-secondary: #8b92a5;
        --text-muted: #5a6075;
        --text-subtle: #2a2d3a;
        --radius: 12px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* Header bar */
      .header-bar {
        border-bottom: 1px solid var(--border);
        padding: 18px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .header-studio {
        font-weight: 600;
        font-size: 15px;
        color: var(--text);
      }

      .header-label {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }

      .header-right {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .header-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-muted);
        animation: pulse 2.4s ease-in-out infinite;
      }

      .header-dot.live { background: #13b5ea; }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }

      .header-time {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.04em;
      }

      /* Container */
      .container {
        padding: 28px 32px;
      }

      @media (max-width: 600px) {
        .container { padding: 20px 16px; }
        .header-bar { padding: 14px 16px; }
      }

      /* Page heading */
      .page-heading {
        margin-bottom: 24px;
      }

      .page-heading h1 {
        font-size: 28px;
        font-weight: 300;
        letter-spacing: -0.02em;
        margin-bottom: 4px;
      }

      .page-url {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        color: var(--text-muted);
        letter-spacing: 0.02em;
      }

      .page-url a {
        color: inherit;
        text-decoration: none;
        transition: color 0.15s;
      }

      .page-url a:hover { color: var(--text-secondary); }

      /* Status banner */
      .status-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-radius: var(--radius);
        margin-bottom: 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        transition: border-color 0.2s;
      }

      .status-banner:hover { border-color: var(--border-hover); }

      .status-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .status-updated {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        color: var(--text-muted);
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--text-muted);
      }

      .status-text {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-secondary);
      }

      .status-banner.operational .status-dot { background: var(--green); }
      .status-banner.operational .status-text { color: var(--green); }
      .status-banner.degraded .status-dot { background: var(--amber); }
      .status-banner.degraded .status-text { color: var(--amber); }
      .status-banner.down .status-dot { background: var(--red); }
      .status-banner.down .status-text { color: var(--red); }

      /* Section */
      .section {
        margin-bottom: 24px;
      }

      .section-title {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-muted);
        margin-bottom: 10px;
      }

      /* Health cards */
      .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
      }

      @media (max-width: 600px) {
        .cards { grid-template-columns: 1fr; }
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        transition: border-color 0.2s;
        min-width: 0;
        overflow-wrap: break-word;
      }

      .card:hover { border-color: var(--border-hover); }

      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }

      .card-label {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-muted);
      }

      .card-badge {
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 100px;
        background: rgba(139, 146, 165, 0.1);
        color: var(--text-muted);
      }

      .card-badge.green {
        background: var(--green-dim);
        color: var(--green);
      }

      .card-badge.amber {
        background: var(--amber-dim);
        color: var(--amber);
      }

      .card-badge.red {
        background: var(--red-dim);
        color: var(--red);
      }

      .card-value {
        font-size: 22px;
        font-weight: 300;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .card-detail {
        font-size: 12px;
        color: var(--text-muted);
      }

      /* Platform status */
      .platform-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      @media (max-width: 600px) {
        .platform-grid { grid-template-columns: 1fr; }
      }

      .platform-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        transition: border-color 0.2s;
      }

      .platform-card:hover { border-color: var(--border-hover); }

      .platform-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
      }

      .platform-name {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-muted);
      }

      .platform-badge {
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 100px;
        background: rgba(139, 146, 165, 0.1);
        color: var(--text-muted);
      }

      .platform-badge.operational {
        background: var(--green-dim);
        color: var(--green);
      }

      .platform-badge.degraded {
        background: var(--amber-dim);
        color: var(--amber);
      }

      .platform-badge.outage {
        background: var(--red-dim);
        color: var(--red);
      }

      .platform-components {
        display: grid;
        gap: 0;
      }

      /* Footer */
      .footer {
        margin-top: 32px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-subtle);
      }

      @media (max-width: 600px) {
        .footer {
          flex-direction: column;
          gap: 6px;
          align-items: flex-start;
        }
      }

      /* Loading skeleton */
      .skeleton {
        background: #1a1c26;
        border-radius: 4px;
        height: 1em;
        display: inline-block;
        animation: skeletonPulse 1.8s ease-in-out infinite;
      }

      @keyframes skeletonPulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 0.8; }
      }
      /* Dynamic content injected by JS — needs global scope */
      .platform-components :global(.platform-component) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        color: #8b92a5;
        padding: 10px 0;
        border-bottom: 1px solid #1e2130;
      }

      .platform-components :global(.platform-component:last-child) { border-bottom: none; }

      .platform-components :global(.component-status) {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #5a6075;
        flex-shrink: 0;
      }

      .platform-components :global(.component-dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #5a6075;
        flex-shrink: 0;
      }

      .platform-components :global(.component-dot.operational) { background: #4aeaab; }
      .platform-components :global(.component-dot.degraded) { background: #f4c97a; }
      .platform-components :global(.component-dot.outage) { background: #f87171; }

      /* Uptime bar */
      .uptime-segment {
        flex: 1;
        border-radius: 2px;
        min-width: 2px;
        transition: opacity 0.15s;
      }
      .uptime-segment:hover { opacity: 0.7; }
      .uptime-segment.up { background: var(--green); }
      .uptime-segment.down { background: var(--red); }
      .uptime-segment.no-data { background: var(--border); }
    </style>
  </head>
  <body>
    <!-- Header bar -->
    <div class="header-bar">
      <div class="header-left">
        <span class="header-studio">OHMY</span>
        <span class="header-label">Status</span>
      </div>
      <div class="header-right">
        <span class="header-dot live" id="live-dot"></span>
        <span class="header-time" id="header-time"></span>
      </div>
    </div>

    <div class="container">
      <!-- Page heading -->
      <div class="page-heading">
        <h1>{site.name}</h1>
        <div class="page-url">
          <a href={site.url} target="_blank" rel="noopener">{site.url}</a>
        </div>
      </div>

      <!-- Overall status banner -->
      <div id="status-banner" class="status-banner">
        <span class="status-dot"></span>
        <div class="status-content">
          <span class="status-text" id="status-text">Checking status&hellip;</span>
          <span class="status-updated" id="status-updated">Checking&hellip;</span>
        </div>
      </div>

      <!-- Site health -->
      <div class="section">
        <div class="section-title">Site Health</div>
        <div class="cards">
          <div class="card">
            <div class="card-header">
              <span class="card-label">Website</span>
              <span class="card-badge" id="http-badge">&nbsp;</span>
            </div>
            <div class="card-value" id="http-value">
              <span class="skeleton" style="width:60px;">&nbsp;</span>
            </div>
            <div class="card-detail" id="http-detail">&nbsp;</div>
          </div>

          <div class="card">
            <div class="card-header">
              <span class="card-label">SSL Certificate</span>
              <span class="card-badge" id="ssl-badge">&nbsp;</span>
            </div>
            <div class="card-value" id="ssl-value">
              <span class="skeleton" style="width:60px;">&nbsp;</span>
            </div>
            <div class="card-detail" id="ssl-detail">&nbsp;</div>
          </div>

          <div class="card">
            <div class="card-header">
              <span class="card-label">Domain</span>
              <span class="card-badge" id="domain-badge">&nbsp;</span>
            </div>
            <div class="card-value" id="domain-value">
              <span class="skeleton" style="width:60px;">&nbsp;</span>
            </div>
            <div class="card-detail" id="domain-detail">&nbsp;</div>
          </div>

          <div class="card">
            <div class="card-header">
              <span class="card-label">DNS</span>
              <span class="card-badge" id="dns-badge">&nbsp;</span>
            </div>
            <div class="card-value" id="dns-value">
              <span class="skeleton" style="width:60px;">&nbsp;</span>
            </div>
            <div class="card-detail" id="dns-detail">&nbsp;</div>
          </div>
        </div>
      </div>

      <!-- Uptime history -->
      <div class="section">
        <div class="section-title">Uptime — Last 7 Days</div>
        <div class="card" style="padding: 24px;">
          <div class="card-header">
            <span class="card-label" id="uptime-pct">Loading&hellip;</span>
            <span class="card-badge" id="uptime-badge">&nbsp;</span>
          </div>
          <div id="uptime-bar" style="display:flex; gap:2px; height:32px; margin-top:8px;">
            <span class="skeleton" style="width:100%; height:32px;">&nbsp;</span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-top:6px;">
            <span class="card-detail" id="uptime-start"></span>
            <span class="card-detail" id="uptime-end"></span>
          </div>
        </div>
      </div>

      <!-- Platform status -->
      <div class="section">
        <div class="section-title">Platform Status</div>
        <div class="platform-grid">
          <div class="platform-card">
            <div class="platform-header">
              <span class="platform-name">DatoCMS</span>
              <span class="platform-badge" id="dato-badge">Loading</span>
            </div>
            <div class="platform-components" id="dato-components">
              <div class="platform-component">
                <span>Checking&hellip;</span>
              </div>
            </div>
          </div>

          <div class="platform-card">
            <div class="platform-header">
              <span class="platform-name">Netlify</span>
              <span class="platform-badge" id="netlify-badge">Loading</span>
            </div>
            <div class="platform-components" id="netlify-components">
              <div class="platform-component">
                <span>Checking&hellip;</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <span>Monitored by OHMY</span>
      </div>
    </div>

    <script define:vars={{ slug: site.slug, base, isDev: import.meta.env.DEV }}>
      const STATUS_URL = isDev
        ? `${base}/status.json`
        : "https://raw.githubusercontent.com/weareohmy/status/main/public/status.json";
      const SERVICES_URL = isDev
        ? `${base}/services.json`
        : "https://raw.githubusercontent.com/weareohmy/status/main/public/services.json";
      const HISTORY_URL = isDev
        ? `${base}/history.json`
        : "https://raw.githubusercontent.com/weareohmy/status/main/public/history.json";

      /* Header time */
      const now = new Date();
      document.querySelector("#header-time").textContent =
        now.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });

      function statusColor(ok, daysLeft, type) {
        if (!ok) return "red";
        if (type === "ssl") {
          if (daysLeft < 7) return "red";
          if (daysLeft < 30) return "amber";
          return "green";
        }
        if (type === "domain") {
          if (daysLeft < 30) return "red";
          if (daysLeft < 60) return "amber";
          return "green";
        }
        return ok ? "green" : "red";
      }

      function serviceStatusClass(status) {
        if (!status) return "";
        const s = status.toLowerCase();
        if (s === "operational" || s === "up") return "operational";
        if (s.includes("degraded") || s.includes("partial")) return "degraded";
        if (s.includes("outage") || s.includes("major") || s === "down") return "outage";
        return "";
      }

      function serviceStatusLabel(status) {
        if (!status) return "Unknown";
        const s = status.toLowerCase();
        if (s === "operational" || s === "up") return "Operational";
        if (s.includes("degraded")) return "Degraded";
        if (s.includes("partial")) return "Partial Outage";
        if (s.includes("major") || s.includes("outage") || s === "down") return "Outage";
        return status;
      }

      const NETLIFY_KEYS = [
        "High-Performance Edge Network",
        "Standard Edge Network",
        "Origin Servers",
        "Build Pipeline",
        "Hosted DNS"
      ];

      const DATO_KEYS = [
        "Content Delivery API",
        "Content Management API",
        "Assets CDN"
      ];

      async function loadStatus() {
        const res = await fetch(STATUS_URL, { cache: "no-store" });
        const data = await res.json();
        const s = data.sites?.[slug];

        const updated = data.generatedAt ? new Date(data.generatedAt) : null;
        document.querySelector("#status-updated").textContent =
          updated ? `Last checked ${updated.toLocaleString()}` : "";

        if (!s) {
          document.querySelector("#status-text").textContent = "No data available";
          document.querySelector("#http-value").textContent = "\u2014";
          document.querySelector("#ssl-value").textContent = "\u2014";
          document.querySelector("#domain-value").textContent = "\u2014";
          document.querySelector("#dns-value").textContent = "\u2014";
          return;
        }

        /* Overall banner */
        const banner = document.querySelector("#status-banner");
        const sslWarn = s.ssl?.ok && s.ssl.daysLeft < 30;
        const domainWarn = s.domain?.ok && s.domain.daysLeft < 60;

        const dnsDown = !s.dns?.ok;
        const dnsWarn = s.dns?.ok && (s.dns.cnameValid === false || s.dns.rootValid === false);

        /* Detect if failures are timeouts (transient) vs genuine outages */
        const httpTimeout = !s.http?.ok && /timeout|abort/i.test(s.http?.error || "");
        const sslTimeout = !s.ssl?.ok && /timeout|abort/i.test(s.ssl?.error || "");
        const allTimeouts = (!s.http?.ok ? httpTimeout : true) && (!s.ssl?.ok ? sslTimeout : true);

        if ((!s.http?.ok || dnsDown) && !allTimeouts) {
          banner.className = "status-banner down";
          document.querySelector("#status-text").textContent = "Issues Detected";
        } else if ((!s.http?.ok || dnsDown) && allTimeouts) {
          banner.className = "status-banner degraded";
          document.querySelector("#status-text").textContent = "Check In Progress";
        } else if (sslWarn || domainWarn || dnsWarn) {
          banner.className = "status-banner degraded";
          document.querySelector("#status-text").textContent = "Attention Required";
        } else {
          banner.className = "status-banner operational";
          document.querySelector("#status-text").textContent = "All Systems Operational";
        }

        /* Update live dot */
        document.querySelector("#live-dot").className = "header-dot live";

        /* HTTP card */
        const httpColor = statusColor(s.http?.ok, null, "http");
        const httpBadge = document.querySelector("#http-badge");
        const httpValue = document.querySelector("#http-value");
        const httpDetail = document.querySelector("#http-detail");
        httpBadge.className = "card-badge " + httpColor;
        if (s.http?.ok) {
          httpBadge.textContent = "Up";
          httpValue.textContent = "Online";
          httpDetail.textContent = `${s.http.ms}ms response`;
        } else {
          const isTimeout = /timeout|abort/i.test(s.http?.error || "");
          httpBadge.textContent = isTimeout ? "Error" : "Down";
          httpValue.textContent = isTimeout ? "Check failed" : "Offline";
          httpDetail.textContent = isTimeout ? "Timed out — will retry" : (s.http?.error ?? "Unreachable");
        }

        /* SSL card */
        const sslColor = statusColor(s.ssl?.ok, s.ssl?.daysLeft, "ssl");
        const sslBadge = document.querySelector("#ssl-badge");
        const sslValue = document.querySelector("#ssl-value");
        const sslDetail = document.querySelector("#ssl-detail");
        sslBadge.className = "card-badge " + sslColor;
        if (s.ssl?.ok) {
          sslBadge.textContent = sslColor === "green" ? "Valid" : sslColor === "amber" ? "Expiring" : "Critical";
          sslValue.textContent = s.ssl.daysLeft > 0 ? `${s.ssl.daysLeft} days remaining` : "Expired";
          sslDetail.textContent = `Expires ${(s.ssl.expiresAt || "").slice(0, 10)}`;
        } else {
          const isTimeout = s.ssl?.error === "timeout" || /abort/i.test(s.ssl?.error || "");
          sslBadge.textContent = isTimeout ? "Error" : "Expired";
          sslValue.textContent = isTimeout ? "Check failed" : "Expired";
          sslDetail.textContent = isTimeout ? "Timed out — will retry" : (s.ssl?.error ?? "No data");
        }

        /* Domain card */
        const domainColor = statusColor(s.domain?.ok, s.domain?.daysLeft, "domain");
        const domainBadge = document.querySelector("#domain-badge");
        const domainValue = document.querySelector("#domain-value");
        const domainDetail = document.querySelector("#domain-detail");
        domainBadge.className = "card-badge " + domainColor;
        if (s.domain?.ok) {
          domainBadge.textContent = domainColor === "green" ? "Valid" : domainColor === "amber" ? "Expiring" : "Critical";
          domainValue.textContent = s.domain.daysLeft > 0 ? `${s.domain.daysLeft} days remaining` : "Expired";
          domainDetail.textContent = `Expires ${(s.domain.expiresAt || "").slice(0, 10)}`;
        } else {
          const isTimeout = /timeout|abort/i.test(s.domain?.error || "");
          domainBadge.textContent = isTimeout ? "Error" : "Expired";
          domainValue.textContent = isTimeout ? "Check failed" : "Expired";
          domainDetail.textContent = isTimeout ? "Timed out — will retry" : (s.domain?.error ?? "Not configured");
        }

        /* DNS card */
        const dnsBadge = document.querySelector("#dns-badge");
        const dnsValue = document.querySelector("#dns-value");
        const dnsDetail = document.querySelector("#dns-detail");
        if (s.dns?.ok) {
          const allValid = s.dns.cnameValid !== false && s.dns.rootValid !== false;
          const anyWarning = s.dns.cnameValid === false || s.dns.rootValid === false;
          dnsBadge.className = "card-badge " + (anyWarning ? "amber" : "green");
          dnsBadge.textContent = anyWarning ? "Warning" : "OK";
          dnsValue.textContent = anyWarning ? "Misconfigured" : "Pointing to Netlify";
          const parts = [];
          if (s.dns.cname) {
            const short = s.dns.cname.replace(/\.netlify\.app$/, '').replace(/\.netlify\.com$/, '');
            parts.push(`www → ${short}` + (s.dns.cnameValid ? '' : ' ✗'));
          }
          if (s.dns.rootA?.length) {
            parts.push(`root → ${s.dns.rootA[0]}` + (s.dns.rootValid ? '' : ' ✗'));
          }
          dnsDetail.textContent = parts.join(" · ") || "Pointing to Netlify";
        } else {
          dnsBadge.className = "card-badge red";
          dnsBadge.textContent = "Fail";
          dnsValue.textContent = "Not resolving";
          dnsDetail.textContent = "Domain not pointing correctly";
        }
      }

      async function loadServices() {
        const res = await fetch(SERVICES_URL, { cache: "no-store" });
        const data = await res.json();

        /* DatoCMS */
        const dato = data.providers?.datocms;
        if (dato) {
          const badge = document.querySelector("#dato-badge");
          const cls = serviceStatusClass(dato.summary);
          badge.className = "platform-badge " + cls;
          badge.textContent = serviceStatusLabel(dato.summary);

          const container = document.querySelector("#dato-components");
          const filtered = (dato.components || []).filter(c => DATO_KEYS.includes(c.name));
          container.innerHTML = filtered.map(c => {
            const dotCls = serviceStatusClass(c.status);
            const label = dotCls === "operational" ? "" : ` ${serviceStatusLabel(c.status)}`;
            return `<div class="platform-component">
              <span>${c.name}</span>
              <span class="component-status">
                <span class="component-dot ${dotCls}"></span>${label}
              </span>
            </div>`;
          }).join("");
        }

        /* Netlify */
        const netlify = data.providers?.netlify;
        if (netlify) {
          const badge = document.querySelector("#netlify-badge");
          const cls = serviceStatusClass(netlify.summary);
          badge.className = "platform-badge " + cls;
          badge.textContent = serviceStatusLabel(netlify.summary);

          const container = document.querySelector("#netlify-components");
          const filtered = (netlify.components || []).filter(c => NETLIFY_KEYS.includes(c.name));
          container.innerHTML = filtered.map(c => {
            const dotCls = serviceStatusClass(c.status);
            const label = dotCls === "operational" ? "" : ` ${serviceStatusLabel(c.status)}`;
            return `<div class="platform-component">
              <span>${c.name}</span>
              <span class="component-status">
                <span class="component-dot ${dotCls}"></span>${label}
              </span>
            </div>`;
          }).join("");
        }
      }

      async function loadHistory() {
        try {
          const res = await fetch(HISTORY_URL, { cache: "no-store" });
          if (!res.ok) throw new Error("not found");
          const data = await res.json();
          const entries = data.sites?.[slug] || [];

          if (entries.length === 0) {
            document.querySelector("#uptime-pct").textContent = "No history yet";
            document.querySelector("#uptime-bar").innerHTML = "";
            return;
          }

          const total = entries.length;
          const okCount = entries.filter(e => e.ok).length;
          const pct = (okCount / total * 100).toFixed(1);

          document.querySelector("#uptime-pct").textContent = `${pct}% uptime`;
          const badge = document.querySelector("#uptime-badge");
          if (pct >= 99.5) { badge.className = "card-badge green"; badge.textContent = "Healthy"; }
          else if (pct >= 95) { badge.className = "card-badge amber"; badge.textContent = "Degraded"; }
          else { badge.className = "card-badge red"; badge.textContent = "Poor"; }

          const SEGMENTS = 84;
          const nowMs = Date.now();
          const sevenDays = 7 * 24 * 60 * 60 * 1000;
          const start = nowMs - sevenDays;
          const bucketSize = sevenDays / SEGMENTS;

          const buckets = Array.from({ length: SEGMENTS }, () => ({ total: 0, ok: 0 }));
          for (const e of entries) {
            const t = new Date(e.t).getTime();
            const idx = Math.min(Math.floor((t - start) / bucketSize), SEGMENTS - 1);
            if (idx >= 0) { buckets[idx].total++; if (e.ok) buckets[idx].ok++; }
          }

          const bar = document.querySelector("#uptime-bar");
          bar.innerHTML = buckets.map(b => {
            const cls = b.total === 0 ? "no-data" : (b.ok === b.total ? "up" : "down");
            return `<div class="uptime-segment ${cls}" title="${b.ok}/${b.total} checks OK"></div>`;
          }).join("");

          document.querySelector("#uptime-start").textContent =
            new Date(start).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
          document.querySelector("#uptime-end").textContent = "Now";
        } catch {
          document.querySelector("#uptime-pct").textContent = "No history yet";
          document.querySelector("#uptime-bar").innerHTML = "";
        }
      }

      Promise.all([loadStatus(), loadServices(), loadHistory()]).catch(() => {
        document.querySelector("#status-text").textContent = "Could not load status data";
      });
    </script>
  </body>
</html>
